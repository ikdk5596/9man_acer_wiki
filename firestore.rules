rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function verifiedGoogle() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email_verified == true;
    }
    function canWriteGuides() {
      return verifiedGoogle()
        && exists(/databases/$(database)/documents/roles/$(request.auth.uid))
        && (get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role == 'webmaster'
          || (exists(/databases/$(database)/documents/rolePolicies/$(get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role))
            && get(/databases/$(database)/documents/rolePolicies/$(get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role)).data.canWriteGuides == true));
    }
    function canWriteDetails() {
      return verifiedGoogle()
        && exists(/databases/$(database)/documents/roles/$(request.auth.uid))
        && (get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role == 'webmaster'
          || (exists(/databases/$(database)/documents/rolePolicies/$(get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role))
            && get(/databases/$(database)/documents/rolePolicies/$(get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role)).data.canWriteDetails == true));
    }
    function canManagePosts() {
      return verifiedGoogle()
        && exists(/databases/$(database)/documents/roles/$(request.auth.uid))
        && get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role in ['admin', 'webmaster'];
    }
    function isWebmaster() {
      return verifiedGoogle()
        && exists(/databases/$(database)/documents/roles/$(request.auth.uid))
        && get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role == 'webmaster';
    }
    function isAdmin() {
      return verifiedGoogle()
        && exists(/databases/$(database)/documents/roles/$(request.auth.uid))
        && get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role == 'admin';
    }
    function validGuide(data) {
      return data.keys().hasAll(['authorId', 'nickname', 'title', 'category', 'body', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['authorId', 'nickname', 'title', 'category', 'body', 'status', 'createdAt', 'updatedAt'])
        && data.authorId is string
        && data.nickname is string && data.nickname.size() >= 1 && data.nickname.size() <= 30
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && data.category is string && data.category in ['초보자', '병사·조합', '전투', '성장·운영', '기타']
        && data.body is string && data.body.size() <= 100000
        && data.status is string && data.status in ['draft', 'published']
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }
    function validProfile(data) {
      return data.keys().hasAll(['alias', 'updatedAt'])
        && data.keys().hasOnly(['alias', 'bio', 'gameServer', 'guild', 'mainHeroes', 'photoVersion', 'updatedAt'])
        && data.alias is string && data.alias.size() >= 1 && data.alias.size() <= 30
        && (!data.keys().hasAny(['bio']) || (data.bio is string && data.bio.size() <= 500))
        && (!data.keys().hasAny(['gameServer']) || (data.gameServer is string && data.gameServer.size() <= 40))
        && (!data.keys().hasAny(['guild']) || (data.guild is string && data.guild.size() <= 40))
        && (!data.keys().hasAny(['mainHeroes']) || (data.mainHeroes is list && data.mainHeroes.size() <= 5))
        && (!data.keys().hasAny(['photoVersion']) || (data.photoVersion is int && data.photoVersion >= 0))
        && data.updatedAt is timestamp;
    }
    function validDetailPost(data) {
      return data.keys().hasAll(['resourceType', 'resourceId', 'resourceKey', 'authorId', 'authorName', 'title', 'body', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['resourceType', 'resourceId', 'resourceKey', 'authorId', 'authorName', 'title', 'body', 'createdAt', 'updatedAt'])
        && data.resourceType is string && data.resourceType in ['soldier', 'exclusive-weapon']
        && data.resourceId is string && data.resourceId.size() >= 1 && data.resourceId.size() <= 100
        && data.resourceKey == data.resourceType + ':' + data.resourceId
        && data.authorId is string
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 100
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 100
        && data.body is string && data.body.size() >= 1 && data.body.size() <= 5000
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }
    function validRole(data) {
      return data.keys().hasAll(['role', 'createdAt', 'updatedAt', 'updatedBy'])
        && data.keys().hasOnly(['role', 'createdAt', 'updatedAt', 'updatedBy'])
        && data.role is string && data.role in ['general', 'writer', 'admin', 'webmaster']
        && data.createdAt is timestamp && data.updatedAt is timestamp
        && data.updatedBy is string;
    }
    function validRolePolicy(data) {
      return data.keys().hasAll(['canWriteGuides', 'canWriteDetails', 'updatedAt', 'updatedBy'])
        && data.keys().hasOnly(['canWriteGuides', 'canWriteDetails', 'updatedAt', 'updatedBy'])
        && data.canWriteGuides is bool && data.canWriteDetails is bool
        && data.updatedAt is timestamp && data.updatedBy is string;
    }
    function validTierRows(tiers, kind) {
      return tiers is map
        && kind in ['soldiers', 'heroes', 'policies']
        && tiers.keys().hasAll(['S', 'A', 'B', 'C', 'D', 'E', 'F'])
        && tiers.keys().hasOnly(['S', 'A', 'B', 'C', 'D', 'E', 'F'])
        && tiers.S is list
        && tiers.A is list
        && tiers.B is list
        && tiers.C is list
        && tiers.D is list
        && tiers.E is list
        && tiers.F is list;
    }

    function validTierBoard(board, kind) {
      return board is map
        && board.keys().hasAll(['tabLabel', 'title', 'tiers'])
        && board.keys().hasOnly(['tabLabel', 'title', 'tiers'])
        && board.tabLabel is string
        && board.tabLabel.size() >= 1
        && board.tabLabel.size() <= 30
        && board.title is string
        && board.title.size() >= 1
        && board.title.size() <= 60
        && validTierRows(board.tiers, kind);
    }

    function validTierBoards(boards, kind) {
      return boards is map
        && boards.keys().hasAll(['overall', 'pvp', 'pve', 'beginner'])
        && boards.keys().hasOnly(['overall', 'pvp', 'pve', 'beginner'])
        && validTierBoard(boards.overall, kind)
        && validTierBoard(boards.pvp, kind)
        && validTierBoard(boards.pve, kind)
        && validTierBoard(boards.beginner, kind);
    }

    function validTierList(data, kind) {
      return data.keys().hasAll(['tiers', 'boards', 'updatedAt', 'updatedBy'])
        && data.keys().hasOnly(['tiers', 'boards', 'updatedAt', 'updatedBy'])
        && validTierRows(data.tiers, kind)
        && validTierBoards(data.boards, kind)
        && data.updatedAt is timestamp
        && data.updatedBy is string;
    }
    match /guides/{guideId} {
      // Keep ownership distinct from schema checks: reads use existing data.
      function ownsGuide() {
        return verifiedGoogle() && resource.data.authorId == request.auth.uid;
      }
      function canReadGuide() {
        return resource.data.status == 'published' || ownsGuide() || canManagePosts();
      }
      allow get: if canReadGuide();
      // Rules are not filters. Callers must constrain status or authorId.
      allow list: if request.query.limit != null
        && request.query.limit <= 20
        && canReadGuide();
      allow create: if canWriteGuides()
        && validGuide(request.resource.data)
        && request.resource.data.authorId == request.auth.uid
        && exists(/databases/$(database)/documents/profiles/$(request.auth.uid))
        && request.resource.data.nickname == get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.alias
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if ((ownsGuide() && canWriteGuides()) || canManagePosts())
        && validGuide(request.resource.data)
        && exists(/databases/$(database)/documents/profiles/$(request.resource.data.authorId))
        && request.resource.data.nickname == get(/databases/$(database)/documents/profiles/$(request.resource.data.authorId)).data.alias
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if ownsGuide() || canManagePosts();
    }
    match /profiles/{uid} {
      allow get: if true;
      allow list: if false;
      allow create, update: if verifiedGoogle()
        && request.auth.uid == uid
        && validProfile(request.resource.data)
        && request.resource.data.updatedAt == request.time;
      allow delete: if verifiedGoogle() && request.auth.uid == uid;
    }
    match /detailPosts/{postId} {
      function ownsPost() {
        return verifiedGoogle() && resource.data.authorId == request.auth.uid;
      }
      allow get: if true;
      allow list: if request.query.limit != null && request.query.limit <= 30;
      allow create: if canWriteDetails()
        && validDetailPost(request.resource.data)
        && request.resource.data.authorId == request.auth.uid
        && exists(/databases/$(database)/documents/profiles/$(request.auth.uid))
        && request.resource.data.authorName == get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.alias
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if ((ownsPost() && canWriteDetails()) || canManagePosts())
        && validDetailPost(request.resource.data)
        && exists(/databases/$(database)/documents/profiles/$(request.resource.data.authorId))
        && request.resource.data.authorName == get(/databases/$(database)/documents/profiles/$(request.resource.data.authorId)).data.alias
        && request.resource.data.resourceType == resource.data.resourceType
        && request.resource.data.resourceId == resource.data.resourceId
        && request.resource.data.resourceKey == resource.data.resourceKey
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if ownsPost() || canManagePosts();
    }
    match /roles/{uid} {
      allow get: if verifiedGoogle() && (request.auth.uid == uid || canManagePosts());
      allow list: if canManagePosts() && request.query.limit != null && request.query.limit <= 100;
      allow create: if verifiedGoogle()
        && validRole(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && (
          (request.auth.uid == uid && request.resource.data.role == 'general')
          || (isWebmaster() && (uid != request.auth.uid || request.resource.data.role == 'webmaster'))
          || (isAdmin() && request.resource.data.role in ['general', 'writer'])
        );
      allow update: if verifiedGoogle()
        && validRole(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && (
          (isWebmaster() && (uid != request.auth.uid || request.resource.data.role == 'webmaster'))
          || (isAdmin()
            && resource.data.role in ['general', 'writer']
            && request.resource.data.role in ['general', 'writer'])
        );
      allow delete: if verifiedGoogle()
        && (
          (isWebmaster() && uid != request.auth.uid)
          || (isAdmin() && resource.data.role in ['general', 'writer'])
        );
    }
    match /rolePolicies/{role} {
      allow get: if verifiedGoogle();
      allow list: if false;
      allow create, update: if isWebmaster()
        && role in ['general', 'writer', 'admin', 'webmaster']
        && validRolePolicy(request.resource.data)
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && (role != 'webmaster' || (request.resource.data.canWriteGuides == true && request.resource.data.canWriteDetails == true));
      allow delete: if false;
    }
    match /tierLists/{kind} {
      // Existing S~F tier boards.
      allow get: if kind in ['soldiers', 'heroes', 'policies'];
      allow list: if false;
      allow create, update: if kind in ['soldiers', 'heroes', 'policies']
        && canManagePosts()
        && validTierList(request.resource.data, kind)
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }

    // Hero advanced-talent ranking is intentionally separate from the
    // generic S~F tier-board schema above.
    match /tierLists/talents {
      allow get: if true;
      allow list: if false;

      allow create, update: if canManagePosts()
        && request.resource.data.keys().hasAll([
          'heroTiers',
          'heroTalentUpdatedAt',
          'heroTalentUpdatedBy'
        ])
        && request.resource.data.keys().hasOnly([
          'heroTiers',
          'heroTalentUpdatedAt',
          'heroTalentUpdatedBy'
        ])
        && request.resource.data.heroTiers is map
        && request.resource.data.heroTiers.size() <= 59
        && request.resource.data.heroTalentUpdatedAt == request.time
        && request.resource.data.heroTalentUpdatedBy == request.auth.uid;

      allow delete: if false;
    }

    // Exclusive-weapon recommended builds are intentionally separate from
    // the generic S~F tier-board schema above.
    match /tierLists/weapon-builds {
      allow get: if true;
      allow list: if false;

      allow create, update: if canManagePosts()
        && request.resource.data.keys().hasAll([
          'weaponBuilds',
          'weaponBuildUpdatedAt',
          'weaponBuildUpdatedBy'
        ])
        && request.resource.data.keys().hasOnly([
          'weaponBuilds',
          'weaponBuildUpdatedAt',
          'weaponBuildUpdatedBy'
        ])
        && request.resource.data.weaponBuilds is map
        && request.resource.data.weaponBuilds.size() <= 24
        && request.resource.data.weaponBuildUpdatedAt == request.time
        && request.resource.data.weaponBuildUpdatedBy == request.auth.uid;

      allow delete: if false;
    }

    match /partyPosts/{partyId} {
      function validParty(data) {
        return data.keys().hasAll([
            'leaderId',
            'leaderName',
            'name',
            'type',
            'departureDate',
            'capacity',
            'approvedCount',
            'description',
            'createdAt',
            'updatedAt'
          ])
          && data.keys().hasOnly([
            'leaderId',
            'leaderName',
            'name',
            'type',
            'departureDate',
            'capacity',
            'approvedCount',
            'description',
            'createdAt',
            'updatedAt'
          ])
          && data.leaderId is string
          && data.leaderId.size() >= 1
          && data.leaderName is string
          && data.leaderName.size() >= 1
          && data.leaderName.size() <= 30
          && data.name is string
          && data.name.size() >= 1
          && data.name.size() <= 60
          && data.type is string
          && data.type in ['rank', 'free']
          && data.departureDate is string
          && data.departureDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && data.capacity is int
          && data.capacity >= 1
          && data.capacity <= 40
          && data.approvedCount is int
          && data.approvedCount >= 0
          && data.approvedCount <= data.capacity
          && data.description is string
          && data.description.size() <= 1000
          && data.createdAt is timestamp
          && data.updatedAt is timestamp;
      }

      function managesParty() {
        return verifiedGoogle()
          && (
            resource.data.leaderId == request.auth.uid
            || canManagePosts()
          );
      }

      function validApplication(data) {
        return data.keys().hasAll([
            'applicantId',
            'gameNickname',
            'gameUid',
            'rank',
            'primaryTroop',
            'secondaryTroop',
            'battleTime',
            'note',
            'status',
            'createdAt',
            'updatedAt'
          ])
          && data.keys().hasOnly([
            'applicantId',
            'gameNickname',
            'gameUid',
            'rank',
            'primaryTroop',
            'secondaryTroop',
            'battleTime',
            'note',
            'status',
            'createdAt',
            'updatedAt'
          ])
          && data.applicantId is string
          && data.applicantId.size() >= 1
          && data.gameNickname is string
          && data.gameNickname.size() >= 1
          && data.gameNickname.size() <= 30
          && data.gameUid is string
          && data.gameUid.size() >= 1
          && data.gameUid.size() <= 50
          && data.rank is string
          && data.rank.size() >= 1
          && data.rank.size() <= 30
          && data.primaryTroop is string
          && data.primaryTroop.size() >= 1
          && data.primaryTroop.size() <= 100
          && data.secondaryTroop is string
          && data.secondaryTroop.size() <= 100
          && data.battleTime is string
          && data.battleTime.size() >= 1
          && data.battleTime.size() <= 100
          && data.note is string
          && data.note.size() <= 500
          && data.status is string
          && data.status in ['pending', 'approved', 'rejected']
          && data.createdAt is timestamp
          && data.updatedAt is timestamp;
      }

      allow get: if true;

      allow list: if request.query.limit != null
        && request.query.limit <= 100;

      allow create: if verifiedGoogle()
        && validParty(request.resource.data)
        && request.resource.data.leaderId == request.auth.uid
        && exists(/databases/$(database)/documents/profiles/$(request.auth.uid))
        && request.resource.data.leaderName
          == get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.alias
        && request.resource.data.approvedCount == 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      // 모집글 자체 수정.
      // approvedCount는 이 경로에서 직접 변경할 수 없다.
      allow update: if verifiedGoogle()
        && validParty(request.resource.data)
        && (
          (
            managesParty()
            && request.resource.data.leaderId == resource.data.leaderId
            && request.resource.data.leaderName == resource.data.leaderName
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.approvedCount == resource.data.approvedCount
            && request.resource.data.updatedAt == request.time
          )
          ||
          (
            // 신청 승인/승인해제 transaction의 counter 변경.
            managesParty()
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['approvedCount', 'updatedAt'])
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.leaderId == resource.data.leaderId
            && request.resource.data.approvedCount
              >= resource.data.approvedCount - 1
            && request.resource.data.approvedCount
              <= resource.data.approvedCount + 1
            && request.resource.data.approvedCount
              != resource.data.approvedCount
            && request.resource.data.updatedAt == request.time
          )
        );

      // applications 서브컬렉션을 남기지 않도록
      // 현재는 부모 모집글 삭제를 허용하지 않는다.
      allow delete: if false;

      match /applications/{applicantUid} {
        function partyBefore() {
          return get(
            /databases/$(database)/documents/partyPosts/$(partyId)
          );
        }

        function partyAfter() {
          return getAfter(
            /databases/$(database)/documents/partyPosts/$(partyId)
          );
        }

        function managesParentParty() {
          return verifiedGoogle()
            && (
              partyBefore().data.leaderId == request.auth.uid
              || canManagePosts()
            );
        }

        function ownsApplication() {
          return verifiedGoogle()
            && applicantUid == request.auth.uid
            && resource.data.applicantId == request.auth.uid;
        }

        allow get: if verifiedGoogle()
          && (
            applicantUid == request.auth.uid
            || managesParentParty()
          );

        allow list: if managesParentParty()
          && request.query.limit != null
          && request.query.limit <= 20;

        // 신청 문서 ID/applicantId는 Firebase Auth UID.
        // gameUid는 사용자가 입력하는 별도의 게임 UID.
        allow create: if verifiedGoogle()
          && applicantUid == request.auth.uid
          && validApplication(request.resource.data)
          && request.resource.data.applicantId == request.auth.uid
          && request.resource.data.status == 'pending'
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && exists(
            /databases/$(database)/documents/partyPosts/$(partyId)
          )
          && partyBefore().data.leaderId != request.auth.uid
          && partyBefore().data.approvedCount < partyBefore().data.capacity;

        allow update: if validApplication(request.resource.data)
          && (
            (
              // 신청자는 pending 상태의 자기 신청 내용만 수정.
              ownsApplication()
              && resource.data.status == 'pending'
              && request.resource.data.status == 'pending'
              && request.resource.data.applicantId
                == resource.data.applicantId
              && request.resource.data.createdAt
                == resource.data.createdAt
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly([
                  'gameNickname',
                  'gameUid',
                  'rank',
                  'primaryTroop',
                  'secondaryTroop',
                  'battleTime',
                  'note',
                  'updatedAt'
                ])
              && request.resource.data.updatedAt == request.time
            )
            ||
            (
              // 파티장/admin/webmaster는 상태만 변경.
              managesParentParty()
              && request.resource.data.applicantId
                == resource.data.applicantId
              && request.resource.data.createdAt
                == resource.data.createdAt
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['status', 'updatedAt'])
              && request.resource.data.status != resource.data.status
              && request.resource.data.updatedAt == request.time
              && (
                (
                  // pending/rejected -> approved
                  resource.data.status != 'approved'
                  && request.resource.data.status == 'approved'
                  && partyAfter().data.approvedCount
                    == partyBefore().data.approvedCount + 1
                  && partyAfter().data.approvedCount
                    <= partyAfter().data.capacity
                )
                ||
                (
                  // approved -> pending/rejected
                  resource.data.status == 'approved'
                  && request.resource.data.status != 'approved'
                  && partyBefore().data.approvedCount > 0
                  && partyAfter().data.approvedCount
                    == partyBefore().data.approvedCount - 1
                )
                ||
                (
                  // pending <-> rejected
                  resource.data.status != 'approved'
                  && request.resource.data.status != 'approved'
                  && partyAfter().data.approvedCount
                    == partyBefore().data.approvedCount
                )
              )
            )
          );

        // 승인된 신청은 신청자가 직접 삭제할 수 없다.
        allow delete: if ownsApplication()
          && resource.data.status != 'approved';
      }
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
