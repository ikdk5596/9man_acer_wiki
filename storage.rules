rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function verifiedGoogle() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email_verified == true;
    }
    function ownsPrefix(uid) {
      return verifiedGoogle() && request.auth.uid == uid;
    }
    function parentExists(guideId) {
      return firestore.exists(/databases/(default)/documents/guides/$(guideId));
    }
    function parent(guideId) {
      return firestore.get(/databases/(default)/documents/guides/$(guideId)).data;
    }
    match /guide-images/{uid}/{guideId}/{filename} {
      function validSlot() {
        return filename.matches('^[0-9]\\.webp$');
      }
      function matchingParent() {
        return parentExists(guideId) && parent(guideId).authorId == uid;
      }
      // Always require a matching parent, including for the owner.
      allow get: if validSlot() && matchingParent()
        && (parent(guideId).status == 'published' || ownsPrefix(uid));
      allow list: if false;
      allow create, update: if validSlot() && ownsPrefix(uid) && matchingParent()
        && request.resource.size <= 1048576
        && request.resource.contentType == 'image/webp';
      // Orphan cleanup stays possible after deleting the Firestore document.
      allow delete: if validSlot() && ownsPrefix(uid);
    }
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
